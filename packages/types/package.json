{
  "name": "encode-yt-monitor-types",
  "version": "0.0.16",
  "description": "前端稳定性监控 通用类型",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "encode-bundle src/index.ts  --format iife,cjs,esm --dts --minify --global-name encodeMonitor",
    "build:es5": "encode-bundle src/index.ts --format iife,cjs,esm --dts --minify --global-name encodeMonitor --target es5",
    "clean": "rimraf dist node_modules"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "encode",
    "monitor",
    "types"
  ],
  "author": "qingfeng",
  "license": "ISC",
  "devDependencies": {
    "encode-bundle": "^1.4.1"
  },
  "dependencies": {
    "encode-yt-monitor-core": "workspace:^",
    "encode-yt-monitor-shared": "workspace:^",
    "encode-yt-monitor-utils": "workspace:^"
  }
}
